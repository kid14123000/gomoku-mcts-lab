[
 {"id":"s1","scene":"s1","at":0.35,"b":4.9,"speed":1.0,
  "text":"十五乘十五的棋盘，一次八百遍模拟。我们把它拆开看。"},

 {"id":"human1","scene":"s_human","at":6.35,"b":5.6,"speed":1.0,
  "text":"你其实只看了四个点。堵这头，它反手那头，成活四。"},
 {"id":"human2","scene":"s_human","at":12.50,"b":8.5,"speed":1.0,
  "text":"换个方向，自己先成四，三步就够。剩下快两百个点你压根没算，先筛掉了。"},

 {"id":"boom","scene":"s_boom","at":22.40,"b":8.6,"speed":1.0,
  "text":"机器没这个本事，它不会先筛。两百个点往下二十层，这个数大到没法念。"},

 {"id":"vs","scene":"s_vs","at":32.40,"b":6.4,"speed":1.0,
  "text":"真正卡住它的，是不知道该看哪儿。算得再快也没用。"},

 {"id":"phase","scene":"s_phase","at":40.40,"b":12.6,"speed":1.04,
  "text":"零六年，有人换了个思路：别急着评估，先算。挑一条路走到头，瞎走到终局，结果原路写回。绕一圈算一次，绕八百圈，答案自己浮出来。"},

 {"id":"rollout","scene":"s_rollout","at":54.30,"b":10.9,"speed":1.06,
  "text":"听起来挺美，可它有坑。随便走出来的结果特别抖，抽十次和抽两千次能差十几个点。而且两边都在乱下，谁都不防守。"},

 {"id":"explore1","scene":"s_explore","at":66.35,"b":3.4,"speed":1.0,
  "text":"还有个问题：先试哪个。"},
 {"id":"explore2","scene":"s_explore","at":70.30,"b":7.0,"speed":1.02,
  "text":"试得越多越不值钱，没试过的反而更容易被选中。这一下叫探索。"},

 {"id":"net","scene":"s_net","at":78.40,"b":10.4,"speed":1.02,
  "text":"一六年，网络进场。它把瞎走到终局换成一次前向，还顺便说该看哪儿：前十个点，吃掉九成先验。"},

 {"id":"walk1","scene":"s_walk","at":90.20,"b":4.2,"speed":1.0,
  "text":"现在把时钟拨慢，看它走一步。"},
 {"id":"walk2","scene":"s_walk","at":95.20,"b":5.6,"speed":1.0,
  "text":"先问网络。它只给概率和估值，不给答案。"},
 {"id":"walk3","scene":"s_walk","at":101.70,"b":6.0,"speed":1.0,
  "text":"第一次进去，一个点都还没落。算完先验就退出来。"},
 {"id":"walk4","scene":"s_walk","at":108.70,"b":8.6,"speed":1.0,
  "text":"第二次，所有点的分数全是零，因为系数还是零。程序按顺序，随手取了 A 一。"},
 {"id":"walk5","scene":"s_walk","at":118.20,"b":8.6,"speed":1.0,
  "text":"第三次，系数终于不是零了。先验最高的那个点，赢。"},
 {"id":"walk6","scene":"s_walk","at":127.70,"b":7.2,"speed":1.0,
  "text":"第四次，它回到刚才那条路。可进去之后又全是零，只好再来一遍。"},
 {"id":"walk7","scene":"s_walk","at":135.70,"b":7.2,"speed":1.0,
  "text":"十四次了。数一下每个点被走过几次，答案就出来了。"},
 {"id":"walk8","scene":"s_walk","at":143.70,"b":3.9,"speed":1.0,
  "text":"八百次，就是把这一套重复八百遍。"},

 {"id":"tree","scene":"s_tree","at":148.40,"b":10.4,"speed":1.0,
  "text":"八百次算完，树长这样。七百九十个局面，最深钻到八层。可有四分之三的边，一辈子只走过一次。"},

 {"id":"pick1","scene":"s_pick","at":160.40,"b":5.5,"speed":1.0,
  "text":"它选了八八那个点。这个答案不是它想出来的，是数出来的。"},
 {"id":"pick2","scene":"s_pick","at":166.40,"b":3.4,"speed":1.0,
  "text":"它不用懂棋，只要把预算分对。"},

 {"id":"selfplay","scene":"s_selfplay","at":170.40,"b":9.4,"speed":1.0,
  "text":"它会下棋了，可还不会变强。自己跟自己下，一局接一局，没有棋谱可背。每手记三样：局面、搜索分布、最后谁赢。"},

 {"id":"train","scene":"s_train","at":181.40,"b":9.4,"speed":1.0,
  "text":"这些数据回头再喂给它。搜索当老师，网络当学生，把八百次模拟的结论，压成一次前向的直觉。"},

 {"id":"twoloop1","scene":"s_twoloop","at":191.40,"b":5.6,"speed":1.0,
  "text":"这一圈分两层跑：内层每手一次，外层每代一次。"},
 {"id":"twoloop2","scene":"s_twoloop","at":197.50,"b":10.6,"speed":1.05,
  "text":"目标不是更正确的棋，是这八百次搜索自己的结论。两者差一点一纳特，一代只挪零点零二五，所以要几百代。"},

 {"id":"loop","scene":"s_loop","at":209.40,"b":12.4,"speed":1.0,
  "text":"于是它开始滚雪球。先验更准，搜索更准，对局更强，数据更好。它没有棋谱，也没有老师。它的老师，就是它自己。"}
]
